"""ARGUS Control Center — main Streamlit application entry."""
import base64
import sys
from pathlib import Path

_ROOT = Path(__file__).parent
sys.path.insert(0, str(_ROOT))

import streamlit as st
from PIL import Image
from streamlit_option_menu import option_menu

from styles import inject_aurora_css
from config import load_argus_config
from views import home, report_studio, reports_archive, tpot_bridge, system_health


# ---------------------------------------------------------------------------
# Brand assets
# ---------------------------------------------------------------------------
STATIC_DIR = _ROOT / "static"
LOGO_PATH = STATIC_DIR / "argus_mark.png"
FAVICON_PATH = STATIC_DIR / "argus_favicon.png"


def _img_b64(path: Path) -> str:
    """Base64-encode an image for inline HTML embedding."""
    return base64.b64encode(path.read_bytes()).decode()


LOGO_B64 = _img_b64(LOGO_PATH)


# ---------------------------------------------------------------------------
# Page config (favicon uses the ARGUS mark)
# ---------------------------------------------------------------------------
st.set_page_config(
    page_title="ARGUS Control Center",
    page_icon=Image.open(FAVICON_PATH),
    layout="wide",
    initial_sidebar_state="expanded",
)

inject_aurora_css()
config = load_argus_config()


# ---------------------------------------------------------------------------
# Brand-specific CSS (self-contained — no styles.py edit needed)
# ---------------------------------------------------------------------------
st.markdown(
    """
    <style>
    /* Sidebar header — clickable logo + wordmark, both route to Home */
    .argus-sidebar-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 4px 4px 12px;
        text-decoration: none !important;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }
    .argus-sidebar-header:hover { opacity: 0.85; }
    .argus-sidebar-logo {
        width: 44px;
        height: 34px;    /* preserves 1.29:1 aspect */
        flex-shrink: 0;
        filter: drop-shadow(0 0 8px rgba(167, 139, 250, 0.25));
    }
    .argus-sidebar-wordmark {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 24px;
        color: #EEEBFA;
        letter-spacing: 4px;
        line-height: 1;
    }

    /* Persistent logo shown only when sidebar is collapsed */
    .argus-persistent-logo {
        position: fixed;
        top: 12px;
        left: 60px;    /* clears Streamlit's expand-arrow */
        z-index: 999990;
        width: 34px;
        height: 26px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.35));
    }
    /* Streamlit sets aria-expanded="false" on the sidebar when collapsed */
    body:has([data-testid="stSidebar"][aria-expanded="false"]) .argus-persistent-logo {
        opacity: 1;
        pointer-events: auto;
    }
    </style>
    """,
    unsafe_allow_html=True,
)


# ---------------------------------------------------------------------------
# Persistent logo (visible when the sidebar is collapsed)
# ---------------------------------------------------------------------------
st.markdown(
    f"""
    <a href="?page=Home" target="_self">
        <img src="data:image/png;base64,{LOGO_B64}"
             class="argus-persistent-logo"
             alt="ARGUS — return to Home"/>
    </a>
    """,
    unsafe_allow_html=True,
)


# ---------------------------------------------------------------------------
# Sidebar — logo + wordmark header, then nav menu, then session context
# ---------------------------------------------------------------------------
with st.sidebar:
    # Custom header replaces the old '# 🛡️ ARGUS' markdown title
    st.markdown(
        f"""
        <a href="?page=Home" target="_self" class="argus-sidebar-header">
            <img src="data:image/png;base64,{LOGO_B64}"
                 class="argus-sidebar-logo"
                 alt="ARGUS mark"/>
            <span class="argus-sidebar-wordmark">ARGUS</span>
        </a>
        """,
        unsafe_allow_html=True,
    )
    st.caption(f"v{config['system']['version']} · Control Center")
    st.markdown("---")

    selected = option_menu(
        menu_title=None,
        options=[
            "Home",
            "Report Studio",
            "Reports Archive",
            "T-Pot Bridge",
            "System Health",
        ],
        icons=[
            "house-fill",
            "file-earmark-text",
            "archive-fill",
            "broadcast-pin",
            "activity",
        ],
        default_index=0,
        styles={
            "container": {"padding": "0!important", "background-color": "transparent"},
            "icon": {"color": "#A78BFA", "font-size": "17px"},
            "nav-link": {
                "font-size": "14px",
                "color": "#EEEBFA",
                "text-align": "left",
                "margin": "3px 0",
                "border-radius": "6px",
                "padding": "10px 12px",
            },
            "nav-link-selected": {
                "background-color": "#4C7DFF",
                "color": "white",
                "font-weight": "600",
            },
        },
    )

    # Session context footer — preserved from before
    st.markdown(
        '<div class="sidebar-footer">'
        '<p class="footer-heading">Session Context</p>'
        '<div class="footer-item">'
        '<i class="bi bi-building"></i>'
        '<div>'
        '<p class="footer-label">Organization</p>'
        f'<p class="footer-value">{config["report"]["organization"]}</p>'
        '</div>'
        '</div>'
        '<div class="footer-item">'
        '<i class="bi bi-clock"></i>'
        '<div>'
        '<p class="footer-label">Timezone</p>'
        f'<p class="footer-value">{config["report"]["timezone"]}</p>'
        '</div>'
        '</div>'
        '</div>',
        unsafe_allow_html=True,
    )


# ---------------------------------------------------------------------------
# Click-to-Home: consume the query param set by logo/wordmark clicks
# ---------------------------------------------------------------------------
if st.query_params.get("page") == "Home":
    selected = "Home"
    st.query_params.clear()


# ---------------------------------------------------------------------------
# Router
# ---------------------------------------------------------------------------
if selected == "Home":
    home.render()
elif selected == "Report Studio":
    report_studio.render()
elif selected == "Reports Archive":
    reports_archive.render()
elif selected == "T-Pot Bridge":
    tpot_bridge.render()
elif selected == "System Health":
    system_health.render()